# 复制成 .env 再填。第 1 集不需要任何 key。

# 第 2、3 集：DeepSeek 开放平台的 API key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=
# 可选：默认用官方的 Anthropic 兼容接口和 deepseek-flash（DeepSeek-V4.1-Flash）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# DEEPSEEK_MODEL=deepseek-flash

# 做视频配音才需要：腾讯云 TokenHub 的按量计费 API key（MiniMax 语音）
TOKENHUB_API_KEY=
